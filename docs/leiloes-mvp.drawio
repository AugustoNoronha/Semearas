<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" agent="SEMEARAS" version="24.7.17" type="device"><diagram id="semearas-1" name="01 — Fluxo do MVP"><mxGraphModel dx="1440" dy="1190" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1190" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="SEMEARAS | Proposta de funcionamento" style="text;html=1;align=left;fontSize=27;fontStyle=1;fontColor=#244D3D;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="20" width="1360" height="40" /></mxCell><mxCell id="subtitle" value="Organização centralizada no ADMIN; autorização do proprietário; inscrição do comprador." style="text;html=1;align=left;fontSize=14;fontColor=#687466;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="65" width="1360" height="35" /></mxCell><mxCell id="label0" value="ADMIN — ORGANIZA O EVENTO" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#244D3D;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="100" width="410" height="30" /></mxCell><mxCell id="label1" value="PROPRIETÁRIO — COMPARTILHA O ITEM" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#244D3D;" vertex="1" parent="1"><mxGeometry as="geometry" x="530" y="100" width="410" height="30" /></mxCell><mxCell id="label2" value="COMPRADOR — SOLICITA PARTICIPAÇÃO" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#244D3D;" vertex="1" parent="1"><mxGeometry as="geometry" x="1020" y="100" width="410" height="30" /></mxCell><mxCell id="a1" value="&lt;b&gt;1. Criar leilão&lt;/b&gt;&lt;br&gt;&lt;br&gt;Código único • título • início e fim&lt;br&gt;Evento começa como RASCUNHO." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;arcSize=9;fontSize=14;strokeColor=#B9C8B4;fillColor=#FFFFFF;fontColor=#253C2E;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="140" width="370" height="150" /></mxCell><mxCell id="o1" value="&lt;b&gt;2. Receber código do evento&lt;/b&gt;&lt;br&gt;&lt;br&gt;Consulta a identificação do leilão.&lt;br&gt;Seu acervo permanece privado." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;arcSize=9;fontSize=14;strokeColor=#B9C8B4;fillColor=#FFFFFF;fontColor=#253C2E;" vertex="1" parent="1"><mxGeometry as="geometry" x="530" y="140" width="370" height="150" /></mxCell><mxCell id="o2" value="&lt;b&gt;3. Autorizar um item próprio&lt;/b&gt;&lt;br&gt;&lt;br&gt;Seleciona animal ou material genético.&lt;br&gt;Cria lote PROPOSTO para aquele evento." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;arcSize=9;fontSize=14;strokeColor=#B9C8B4;fillColor=#FFFFFF;fontColor=#253C2E;" vertex="1" parent="1"><mxGeometry as="geometry" x="530" y="340" width="370" height="150" /></mxCell><mxCell id="a2" value="&lt;b&gt;4. Aprovar lote e condições&lt;/b&gt;&lt;br&gt;&lt;br&gt;Abertura e incremento autorizados.&lt;br&gt;Item + vendedor + quantidade definidos." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;arcSize=9;fontSize=14;strokeColor=#B9C8B4;fillColor=#FFFFFF;fontColor=#253C2E;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="340" width="370" height="150" /></mxCell><mxCell id="a3" value="&lt;b&gt;5. Publicar e agendar&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ao menos um lote aprovado.&lt;br&gt;Datas e condições ficam congeladas." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;arcSize=9;fontSize=14;strokeColor=#B9C8B4;fillColor=#FFFFFF;fontColor=#253C2E;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="540" width="370" height="150" /></mxCell><mxCell id="o3" value="&lt;b&gt;Dados da oferta preservados&lt;/b&gt;&lt;br&gt;&lt;br&gt;Snapshot preserva a oferta aprovada.&lt;br&gt;Sem alterações enquanto comprometido." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;arcSize=9;fontSize=14;strokeColor=#B9C8B4;fillColor=#FFFFFF;fontColor=#253C2E;" vertex="1" parent="1"><mxGeometry as="geometry" x="530" y="540" width="370" height="150" /></mxCell><mxCell id="b1" value="&lt;b&gt;6. Solicitar inscrição&lt;/b&gt;&lt;br&gt;&lt;br&gt;Usuário autenticado aceita as condições.&lt;br&gt;Uma inscrição por usuário e evento." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;arcSize=9;fontSize=14;strokeColor=#B9C8B4;fillColor=#FFFFFF;fontColor=#253C2E;" vertex="1" parent="1"><mxGeometry as="geometry" x="1020" y="540" width="370" height="150" /></mxCell><mxCell id="a4" value="&lt;b&gt;7. Aprovar inscrição&lt;/b&gt;&lt;br&gt;&lt;br&gt;PENDENTE → APROVADA / RECUSADA.&lt;br&gt;Proposta: decisão antes do início." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;arcSize=9;fontSize=14;strokeColor=#B9C8B4;fillColor=#FFFFFF;fontColor=#253C2E;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="790" width="370" height="150" /></mxCell><mxCell id="clock" value="&lt;b&gt;8. Respeitar a janela do evento&lt;/b&gt;&lt;br&gt;&lt;br&gt;Início ≤ horário do servidor &amp;lt; fim.&lt;br&gt;Fim fixo, sem prorrogação no MVP." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;arcSize=9;fontSize=14;strokeColor=#B9C8B4;fillColor=#FFFFFF;fontColor=#253C2E;" vertex="1" parent="1"><mxGeometry as="geometry" x="530" y="790" width="370" height="150" /></mxCell><mxCell id="b2" value="&lt;b&gt;Fase seguinte: disputar lotes&lt;/b&gt;&lt;br&gt;&lt;br&gt;Somente inscrito aprovado.&lt;br&gt;Não pode lançar no próprio item." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;arcSize=9;fontSize=14;strokeColor=#B39A70;fillColor=#FFFDF8;fontColor=#253C2E;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1020" y="790" width="370" height="150" /></mxCell><mxCell id="result" value="&lt;b&gt;Resultado por lote — fase seguinte&lt;/b&gt;&lt;br&gt;&lt;br&gt;ARREMATADO ou SEM_LANCES.&lt;br&gt;Pagamento e transferência vêm depois." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;arcSize=9;fontSize=14;strokeColor=#B39A70;fillColor=#FFFDF8;fontColor=#253C2E;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="530" y="1010" width="370" height="120" /></mxCell><mxCell id="edge0" value="compartilha código" source="a1" target="o1" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#687466;fontColor=#253C2E;fontSize=12;labelBackgroundColor=#FAF9F6;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge1" value="" source="o1" target="o2" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#687466;fontColor=#253C2E;fontSize=12;labelBackgroundColor=#FAF9F6;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge2" value="submete para aprovação" source="o2" target="a2" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#687466;fontColor=#253C2E;fontSize=12;labelBackgroundColor=#FAF9F6;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge3" value="" source="a2" target="a3" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#687466;fontColor=#253C2E;fontSize=12;labelBackgroundColor=#FAF9F6;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge4" value="" source="a3" target="o3" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#687466;fontColor=#253C2E;fontSize=12;labelBackgroundColor=#FAF9F6;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge5" value="abre inscrições" source="o3" target="b1" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#687466;fontColor=#253C2E;fontSize=12;labelBackgroundColor=#FAF9F6;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge6" value="avaliação" source="b1" target="a4" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#687466;fontColor=#253C2E;fontSize=12;labelBackgroundColor=#FAF9F6;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1205" y="740" /><mxPoint x="225" y="740" /></Array></mxGeometry></mxCell><mxCell id="edge7" value="" source="a4" target="clock" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#687466;fontColor=#253C2E;fontSize=12;labelBackgroundColor=#FAF9F6;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge8" value="quando habilitarmos lances" source="clock" target="b2" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#687466;fontColor=#253C2E;fontSize=12;labelBackgroundColor=#FAF9F6;dashed=1;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge9" value="encerramento" source="b2" target="result" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#687466;fontColor=#253C2E;fontSize=12;labelBackgroundColor=#FAF9F6;dashed=1;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1205" y="1070" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="semearas-2" name="02 — Estados e horários"><mxGraphModel dx="1440" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="SEMEARAS | Estados e regras de tempo" style="text;html=1;align=left;fontSize=27;fontStyle=1;fontColor=#244D3D;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="20" width="1360" height="40" /></mxCell><mxCell id="subtitle" value="O estado efetivo depende do relógio do servidor; o fechamento deve ser idempotente." style="text;html=1;align=left;fontSize=14;fontColor=#687466;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="65" width="1360" height="35" /></mxCell><mxCell id="label0" value="INSCRIÇÃO DO COMPRADOR" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#244D3D;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="610" width="410" height="30" /></mxCell><mxCell id="draft" value="&lt;b&gt;RASCUNHO&lt;/b&gt;&lt;br&gt;&lt;br&gt;ADMIN prepara o evento.&lt;br&gt;Proprietários autorizam os itens." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;arcSize=9;fontSize=14;strokeColor=#B9C8B4;fillColor=#FFFFFF;fontColor=#253C2E;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="160" width="300" height="150" /></mxCell><mxCell id="scheduled" value="&lt;b&gt;AGENDADO&lt;/b&gt;&lt;br&gt;&lt;br&gt;Publicado com lotes aprovados.&lt;br&gt;Inscrições e análise até o início." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;arcSize=9;fontSize=14;strokeColor=#B9C8B4;fillColor=#FFFFFF;fontColor=#253C2E;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="160" width="300" height="150" /></mxCell><mxCell id="running" value="&lt;b&gt;EM_ANDAMENTO&lt;/b&gt;&lt;br&gt;&lt;br&gt;Janela de lances aberta.&lt;br&gt;Somente na futura fase de lances." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;arcSize=9;fontSize=14;strokeColor=#B9C8B4;fillColor=#FFFFFF;fontColor=#253C2E;" vertex="1" parent="1"><mxGeometry as="geometry" x="740" y="160" width="300" height="150" /></mxCell><mxCell id="closed" value="&lt;b&gt;ENCERRADO&lt;/b&gt;&lt;br&gt;&lt;br&gt;Não aceita novos lances.&lt;br&gt;Apuração de resultados por lote." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;arcSize=9;fontSize=14;strokeColor=#B9C8B4;fillColor=#FFFFFF;fontColor=#253C2E;" vertex="1" parent="1"><mxGeometry as="geometry" x="1090" y="160" width="300" height="150" /></mxCell><mxCell id="canceled" value="&lt;b&gt;CANCELADO&lt;/b&gt;&lt;br&gt;&lt;br&gt;Com motivo e auditoria.&lt;br&gt;Cancelamento comum antes do início." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;arcSize=9;fontSize=14;strokeColor=#B9C8B4;fillColor=#FFFFFF;fontColor=#253C2E;" vertex="1" parent="1"><mxGeometry as="geometry" x="215" y="400" width="300" height="130" /></mxCell><mxCell id="timerule" value="&lt;b&gt;Regra exata de aceitação&lt;/b&gt;&lt;br&gt;&lt;br&gt;starts_at ≤ instante real do servidor &amp;lt; ends_at&lt;br&gt;Validar após obter os locks; cron atrasado não estende prazo." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;arcSize=9;fontSize=14;strokeColor=#B9C8B4;fillColor=#FFFFFF;fontColor=#253C2E;" vertex="1" parent="1"><mxGeometry as="geometry" x="740" y="400" width="650" height="130" /></mxCell><mxCell id="pending" value="&lt;b&gt;PENDENTE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Solicitação com aceite das condições." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;arcSize=9;fontSize=14;strokeColor=#B9C8B4;fillColor=#FFFFFF;fontColor=#253C2E;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="650" width="300" height="120" /></mxCell><mxCell id="approved" value="&lt;b&gt;APROVADA&lt;/b&gt;&lt;br&gt;&lt;br&gt;Pode disputar itens de outros donos." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;arcSize=9;fontSize=14;strokeColor=#B9C8B4;fillColor=#FFFFFF;fontColor=#253C2E;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="650" width="300" height="120" /></mxCell><mxCell id="rejected" value="&lt;b&gt;RECUSADA&lt;/b&gt;&lt;br&gt;&lt;br&gt;Motivo registrado; histórico preservado." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;arcSize=9;fontSize=14;strokeColor=#B9C8B4;fillColor=#FFFFFF;fontColor=#253C2E;" vertex="1" parent="1"><mxGeometry as="geometry" x="740" y="650" width="300" height="120" /></mxCell><mxCell id="withdrawn" value="&lt;b&gt;CANCELADA&lt;/b&gt;&lt;br&gt;&lt;br&gt;Desistência antes do início." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;arcSize=9;fontSize=14;strokeColor=#B9C8B4;fillColor=#FFFFFF;fontColor=#253C2E;" vertex="1" parent="1"><mxGeometry as="geometry" x="1090" y="650" width="300" height="120" /></mxCell><mxCell id="lotresult" value="&lt;b&gt;Resultado não significa pagamento&lt;/b&gt;&lt;br&gt;&lt;br&gt;ARREMATADO identifica vencedor e valor; SEM_LANCES indica ausência de lance válido." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;arcSize=9;fontSize=14;strokeColor=#B39A70;fillColor=#FFFDF8;fontColor=#253C2E;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="910" width="650" height="100" /></mxCell><mxCell id="edge0" value="publicar" source="draft" target="scheduled" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#687466;fontColor=#253C2E;fontSize=12;labelBackgroundColor=#FAF9F6;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge1" value="início" source="scheduled" target="running" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#687466;fontColor=#253C2E;fontSize=12;labelBackgroundColor=#FAF9F6;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge2" value="fim" source="running" target="closed" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#687466;fontColor=#253C2E;fontSize=12;labelBackgroundColor=#FAF9F6;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge3" value="cancelar" source="draft" target="canceled" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#687466;fontColor=#253C2E;fontSize=12;labelBackgroundColor=#FAF9F6;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge4" value="cancelar" source="scheduled" target="canceled" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#687466;fontColor=#253C2E;fontSize=12;labelBackgroundColor=#FAF9F6;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge5" value="ADMIN" source="pending" target="approved" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#687466;fontColor=#253C2E;fontSize=12;labelBackgroundColor=#FAF9F6;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge6" value="ADMIN" source="pending" target="rejected" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#687466;fontColor=#253C2E;fontSize=12;labelBackgroundColor=#FAF9F6;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="190" y="810" /><mxPoint x="890" y="810" /></Array></mxGeometry></mxCell><mxCell id="edge7" value="antes do início" source="approved" target="withdrawn" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#687466;fontColor=#253C2E;fontSize=12;labelBackgroundColor=#FAF9F6;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="540" y="850" /><mxPoint x="1240" y="850" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="semearas-3" name="03 — Modelo de dados"><mxGraphModel dx="1440" dy="970" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="970" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="SEMEARAS | Modelo conceitual" style="text;html=1;align=left;fontSize=27;fontStyle=1;fontColor=#244D3D;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="20" width="1360" height="40" /></mxCell><mxCell id="subtitle" value="Separar evento, lote e inscrição. Cada evento pode começar com um único lote." style="text;html=1;align=left;fontSize=14;fontColor=#687466;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="65" width="1360" height="35" /></mxCell><mxCell id="users" value="&lt;b&gt;users — existente&lt;/b&gt;&lt;br&gt;&lt;br&gt;id • name • role (USER / ADMIN)&lt;br&gt;Organizador, vendedor ou participante." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;arcSize=9;fontSize=14;strokeColor=#B9C8B4;fillColor=#EEF3E8;fontColor=#253C2E;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="140" width="310" height="160" /></mxCell><mxCell id="items" value="&lt;b&gt;catalog_items — existente&lt;/b&gt;&lt;br&gt;&lt;br&gt;id • owner_id • category&lt;br&gt;Animal ou material genético.&lt;br&gt;Dados cadastrais privados.&lt;br&gt;Quantidade inteira no primeiro MVP." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;arcSize=9;fontSize=14;strokeColor=#B9C8B4;fillColor=#EEF3E8;fontColor=#253C2E;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="430" width="310" height="250" /></mxCell><mxCell id="auctions" value="&lt;b&gt;auctions&lt;/b&gt;&lt;br&gt;&lt;br&gt;id • code UNIQUE • created_by&lt;br&gt;title • description • terms_version&lt;br&gt;starts_at • ends_at • display_timezone&lt;br&gt;status • created_at • updated_at" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;arcSize=9;fontSize=14;strokeColor=#B9C8B4;fillColor=#FFFFFF;fontColor=#253C2E;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="140" width="390" height="250" /></mxCell><mxCell id="lots" value="&lt;b&gt;auction_lots&lt;/b&gt;&lt;br&gt;&lt;br&gt;id • code UNIQUE • auction_id&lt;br&gt;catalog_item_id • seller_id&lt;br&gt;opening_bid • bid_increment&lt;br&gt;status • item_snapshot&lt;br&gt;consented_at • approved_by • approved_at&lt;br&gt;Resultado apurado na fase de lances." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;arcSize=9;fontSize=14;strokeColor=#B9C8B4;fillColor=#FFFFFF;fontColor=#253C2E;" vertex="1" parent="1"><mxGeometry as="geometry" x="980" y="140" width="400" height="330" /></mxCell><mxCell id="registrations" value="&lt;b&gt;auction_registrations&lt;/b&gt;&lt;br&gt;&lt;br&gt;id • auction_id • user_id&lt;br&gt;status • terms_version • accepted_terms_at&lt;br&gt;requested_at • reviewed_by • reviewed_at&lt;br&gt;UNIQUE (auction_id, user_id)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;arcSize=9;fontSize=14;strokeColor=#B9C8B4;fillColor=#FFFFFF;fontColor=#253C2E;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="540" width="390" height="250" /></mxCell><mxCell id="bids" value="&lt;b&gt;bids — fase seguinte&lt;/b&gt;&lt;br&gt;&lt;br&gt;id • lot_id • bidder_id • amount&lt;br&gt;accepted_at • sequence • idempotency_key&lt;br&gt;Histórico imutável de lances aceitos.&lt;br&gt;Liderança e resultado com vínculo ao lance." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;arcSize=9;fontSize=14;strokeColor=#B39A70;fillColor=#FFFDF8;fontColor=#253C2E;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="980" y="600" width="400" height="250" /></mxCell><mxCell id="private" value="&lt;b&gt;Privacidade e autorização&lt;/b&gt;&lt;br&gt;&lt;br&gt;Só o item compartilhado entra no lote.&lt;br&gt;Snapshot não transfere propriedade." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;arcSize=9;fontSize=14;strokeColor=#B9C8B4;fillColor=#FFFFFF;fontColor=#253C2E;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="790" width="310" height="110" /></mxCell><mxCell id="edge0" value="1 → N organiza" source="users" target="auctions" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#687466;fontColor=#253C2E;fontSize=12;labelBackgroundColor=#FAF9F6;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge1" value="1 → N possui" source="users" target="items" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#687466;fontColor=#253C2E;fontSize=12;labelBackgroundColor=#FAF9F6;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge2" value="1 → N lotes" source="auctions" target="lots" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#687466;fontColor=#253C2E;fontSize=12;labelBackgroundColor=#FAF9F6;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge3" value="1 → N histórico" source="items" target="lots" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#687466;fontColor=#253C2E;fontSize=12;labelBackgroundColor=#FAF9F6;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="430" y="555" /><mxPoint x="430" y="430" /><mxPoint x="930" y="430" /><mxPoint x="930" y="305" /></Array></mxGeometry></mxCell><mxCell id="edge4" value="1 → N inscrições" source="auctions" target="registrations" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#687466;fontColor=#253C2E;fontSize=12;labelBackgroundColor=#FAF9F6;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge5" value="1 → N participa" source="users" target="registrations" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#687466;fontColor=#253C2E;fontSize=12;labelBackgroundColor=#FAF9F6;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="390" y="220" /><mxPoint x="390" y="665" /></Array></mxGeometry></mxCell><mxCell id="edge6" value="1 → N lances" source="lots" target="bids" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#687466;fontColor=#253C2E;fontSize=12;labelBackgroundColor=#FAF9F6;dashed=1;"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram><diagram id="semearas-4" name="04 — Arquitetura e evolução"><mxGraphModel dx="1740" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1740" pageHeight="820" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="SEMEARAS | Arquitetura sugerida" style="text;html=1;align=left;fontSize=27;fontStyle=1;fontColor=#244D3D;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="20" width="1660" height="40" /></mxCell><mxCell id="subtitle" value="Usar as camadas atuais. RabbitMQ/SQS não é necessário para preparar e publicar eventos." style="text;html=1;align=left;fontSize=14;fontColor=#687466;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="65" width="1660" height="35" /></mxCell><mxCell id="front" value="&lt;b&gt;Front web / mobile&lt;/b&gt;&lt;br&gt;&lt;br&gt;Eventos • lotes • inscrições&lt;br&gt;ADMIN e usuário com visões próprias." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;arcSize=9;fontSize=14;strokeColor=#B9C8B4;fillColor=#FFFFFF;fontColor=#253C2E;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="150" width="300" height="180" /></mxCell><mxCell id="controller" value="&lt;b&gt;controller&lt;/b&gt;&lt;br&gt;&lt;br&gt;Valida JWT, permissões e entradas.&lt;br&gt;Expõe os endpoints." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;arcSize=9;fontSize=14;strokeColor=#B9C8B4;fillColor=#FFFFFF;fontColor=#253C2E;" vertex="1" parent="1"><mxGeometry as="geometry" x="380" y="150" width="300" height="180" /></mxCell><mxCell id="services" value="&lt;b&gt;services → impl&lt;/b&gt;&lt;br&gt;&lt;br&gt;AuctionService • AuctionLotService&lt;br&gt;AuctionRegistrationService&lt;br&gt;BidService apenas na fase seguinte." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;arcSize=9;fontSize=14;strokeColor=#B9C8B4;fillColor=#FFFFFF;fontColor=#253C2E;" vertex="1" parent="1"><mxGeometry as="geometry" x="720" y="150" width="300" height="180" /></mxCell><mxCell id="repository" value="&lt;b&gt;repository → impl&lt;/b&gt;&lt;br&gt;&lt;br&gt;Contratos + implementação JDBC.&lt;br&gt;Transações e consultas persistentes." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;arcSize=9;fontSize=14;strokeColor=#B9C8B4;fillColor=#FFFFFF;fontColor=#253C2E;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="150" width="300" height="180" /></mxCell><mxCell id="db" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;br&gt;Eventos • lotes • inscrições&lt;br&gt;Lances e resultados na fase seguinte." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;arcSize=9;fontSize=14;strokeColor=#B9C8B4;fillColor=#FFFFFF;fontColor=#253C2E;" vertex="1" parent="1"><mxGeometry as="geometry" x="1400" y="150" width="300" height="180" /></mxCell><mxCell id="accept" value="&lt;b&gt;Fase de lances: aceitação atômica&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bloquear o lote e revalidar horário, inscrição e valor.&lt;br&gt;Gravar lance e liderança na mesma transação.&lt;br&gt;Não declarar aceito antes do commit." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;arcSize=9;fontSize=14;strokeColor=#B39A70;fillColor=#FFFDF8;fontColor=#253C2E;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="380" y="460" width="640" height="170" /></mxCell><mxCell id="queue" value="&lt;b&gt;Evolução: eventos / notificações&lt;/b&gt;&lt;br&gt;&lt;br&gt;RabbitMQ ou SQS, escolha posterior.&lt;br&gt;Eventos após commit; fila não substitui consistência.&lt;br&gt;Interface pode acompanhar por polling / atualização futura." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;arcSize=9;fontSize=14;strokeColor=#B39A70;fillColor=#FFFDF8;fontColor=#253C2E;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1130" y="460" width="500" height="170" /></mxCell><mxCell id="edge0" value="" source="front" target="controller" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#687466;fontColor=#253C2E;fontSize=12;labelBackgroundColor=#FAF9F6;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge1" value="" source="controller" target="services" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#687466;fontColor=#253C2E;fontSize=12;labelBackgroundColor=#FAF9F6;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge2" value="" source="services" target="repository" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#687466;fontColor=#253C2E;fontSize=12;labelBackgroundColor=#FAF9F6;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge3" value="" source="repository" target="db" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#687466;fontColor=#253C2E;fontSize=12;labelBackgroundColor=#FAF9F6;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge4" value="fase seguinte" source="services" target="accept" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#687466;fontColor=#253C2E;fontSize=12;labelBackgroundColor=#FAF9F6;dashed=1;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge5" value="evento confirmado" source="accept" target="queue" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#687466;fontColor=#253C2E;fontSize=12;labelBackgroundColor=#FAF9F6;dashed=1;"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram></mxfile>